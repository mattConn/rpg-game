{
  "name": "singleplayer-rpg-tactics",
  "version": "1.0.0",
  "description": "Turn-based 3x3 skirmish on the same 3D models and the same UI as the real-time game.",
  "type": "module",
  "scripts": {
    "build:game": "esbuild src/client/main.ts --bundle --format=iife --sourcemap --alias:three=./node_modules/three --outfile=public/tactics.js",
    "build:editor": "esbuild src/editor/main.ts --bundle --format=iife --sourcemap --outfile=public/editor.js",
    "build:client": "npm run build:game && npm run build:editor",
    "watch:client": "npm run build:client -- --watch",
    "start": "npm run build:client && tsx src/server/index.ts",
    "dev": "npm run build:client && tsx watch src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:lods": "node scripts/generate-lods.mjs",
    "build:textures": "node scripts/generate-textures.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "fastify": "^5.10.0",
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "meshoptimizer": "^1.1.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
